# 环境变量模板
# 复制为 .env 并填入实际值
# cp .env.example .env

# ===== 云端 GLM（三元组抽取用，必填）=====
GLM_API_KEY=你的智谱AI_API_Key
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=glm-4-plus

# ===== Ollama（本地问答用，按实际修改）=====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_QA_MODEL=deepseek-r1:7b
OLLAMA_EMBED_MODEL=bge-large:latest

# ===== 向量库路径（复用 enterprise-rag，必填）=====
VECTOR_STORE_PATH=
VECTOR_STORE_TYPE=faiss

# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8000
DEBUG=true
